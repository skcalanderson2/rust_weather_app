 <Method>
  <ItemName>PopulateWMOCodes</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1671075839</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub PopulateWMOCodes()</SourceLine>
   <SourceLine>App.WMOCodes = new Dictionary</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 0 – Clear sky</SourceLine>
   <SourceLine>App.WMOCodes.Value(0) = "clearsky"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 1, 2, 3 – Mainly clear, partly cloudy, and overcast</SourceLine>
   <SourceLine>App.WMOCodes.Value(1) = "mainlyclear"</SourceLine>
   <SourceLine>App.WMOCodes.Value(2) = "partlycloudy"</SourceLine>
   <SourceLine>App.WMOCodes.Value(3) = "overcast"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 45, 48 – Fog and depositing rime fog</SourceLine>
   <SourceLine>App.WMOCodes.Value(45) = "fog"</SourceLine>
   <SourceLine>App.WMOCodes.Value(48) = "depositingrimefog"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 51, 53, 55 – Drizzle Light, moderate, and dense </SourceLine>
   <SourceLine>App.WMOCodes.Value(51) = "drizzlelight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(53) = "drizzlemoderate"</SourceLine>
   <SourceLine>App.WMOCodes.Value(55) = "drizzledense"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 56, 57 – Freezing Drizzle Light and dense </SourceLine>
   <SourceLine>App.WMOCodes.Value(56) = "freezingdrizzlelight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(57) = "freezingdrizzledense"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 61, 63, 65 – Rain Slight, moderate and heavy </SourceLine>
   <SourceLine>App.WMOCodes.Value(61) = "rainlight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(63) = "rainmoderate"</SourceLine>
   <SourceLine>App.WMOCodes.Value(65) = "rainheavy"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 66, 67 – Freezing Rain Light and heavy </SourceLine>
   <SourceLine>App.WMOCodes.Value(66) = "freezingrainlight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(67) = "freezingrainheavy"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 71, 73, 75 – Snow fall Slight, moderate, and heavy </SourceLine>
   <SourceLine>App.WMOCodes.Value(71) = "snowfalllight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(73) = "snowfallmoderate"</SourceLine>
   <SourceLine>App.WMOCodes.Value(75) = "snowfallheavy"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 77 – Snow grains</SourceLine>
   <SourceLine>App.WMOCodes.Value(77) = "snowgrains"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 80, 81, 82 – Rain showers Slight, moderate, and violent</SourceLine>
   <SourceLine>App.WMOCodes.Value(80) = "rainshowerslight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(81) = "rainshowersmoderate"</SourceLine>
   <SourceLine>App.WMOCodes.Value(82) = "rainshowersviolent"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 85, 86 – Snow showers slight and heavy</SourceLine>
   <SourceLine>App.WMOCodes.Value(85) = "snowshowerslight"</SourceLine>
   <SourceLine>App.WMOCodes.Value(86) = "snowshowersheavy"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// 95 – *Thunderstorm Slight or moderate</SourceLine>
   <SourceLine>App.WMOCodes.Value(95) = "thunderstorms"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
