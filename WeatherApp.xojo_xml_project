 <Method>
  <ItemName>SetScreen</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>739274751</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SetScreen(weatherData As Dictionary)</SourceLine>
   <SourceLine>//Current Weather Data</SourceLine>
   <SourceLine>var data as Dictionary = weatherData.Value("current")</SourceLine>
   <SourceLine>var temp as Double = data.Value("temperature_2m")</SourceLine>
   <SourceLine>var windchilltemp as Double = data.Value("apparent_temperature")</SourceLine>
   <SourceLine>var isDay as Integer = data.value("is_day")</SourceLine>
   <SourceLine>var overcast as Integer = data.value("cloud_cover")</SourceLine>
   <SourceLine>var windSpeed as Integer = data.value("wind_speed_10m")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//Forecast Weather Data</SourceLine>
   <SourceLine>var dailydata as Dictionary = weatherData.Value("daily")</SourceLine>
   <SourceLine>var forecast_times() as Variant = dailydata.Value("time")</SourceLine>
   <SourceLine>var weather_codes() as Variant = dailydata.Value("weather_code")</SourceLine>
   <SourceLine>var maxtemps() as Variant = dailydata.Value("temperature_2m_max")</SourceLine>
   <SourceLine>var mintemps() as Variant = dailydata.Value("temperature_2m_min")</SourceLine>
   <SourceLine>var precip() as Variant = dailydata.Value("precipitation_probability_max")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>var dates() as DateTime</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//var aDate as DateTime = DateTime.FromString(forecast_times(0))</SourceLine>
   <SourceLine>dates.Add(DateTime.FromString(forecast_times(0)))</SourceLine>
   <SourceLine>dates.Add(DateTime.FromString(forecast_times(1)))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UpdateForecast(dates, weather_codes, maxtemps, mintemps, precip)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>currentTemperature.Text = "Current Temp: " + temp.ToString + "° F"</SourceLine>
   <SourceLine>windChill.Text = "Windchill Temp: " + windchilltemp.ToString + "° F"</SourceLine>
   <SourceLine>windSpeedLbl.Text = windSpeed.ToString + " Mph"</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Select Case isDay</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>if overcast &lt; 20 then</SourceLine>
   <SourceLine>DayNight.Backdrop = clearday</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>DayNight.Backdrop = overcastday</SourceLine>
   <SourceLine>end</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>DayNight.Backdrop = clearnight</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>weatherData As Dictionary</ItemParams>
  <ItemResult></ItemResult>
 </Method>
