  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UpdateForecast(dates() as DateTime, weather_code() as Variant, maxtemps() as Variant, mintemps() as Variant, precip() as Variant)</SourceLine>
   <SourceLine>ForecastDay1.Text = dates(1).ToString("EEE d")</SourceLine>
   <SourceLine>ForecastMaxTemp1.Text = "Max Temp: " + Format(maxtemps(1), "-#.##") + "°F"</SourceLine>
   <SourceLine>ForecastMinTemp1.Text = "Min Temp: " + Format(mintemps(1), "-#.##") + "°F"</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
